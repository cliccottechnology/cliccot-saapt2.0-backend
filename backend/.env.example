SECRET_KEY=django-insecure-change-this-in-production-key-saapt-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
 
# Database Configuration (PostgreSQL / SQLite fallback)
# Set DB_ENGINE=postgres to use PostgreSQL, or leave blank/sqlite for SQLite
DB_ENGINE=postgres
DB_NAME=postgres
DB_SCHEMA=saapt_db
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer
# Or alternatively provide a single connection URL:
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Email Configuration (for OTP and notifications)
# Leave EMAIL_HOST_USER blank for development console backend output
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@saapt.com

